{
  // 워크스페이스 공통 타입스크립트 설정 (apps/web-*가 상속)
  "compilerOptions": {
    // 엄격 모드
    "strict": true,
    // 외부 라이브러리 타입 검사 스킵(속도/안정성)
    "skipLibCheck": true,
    // JSON import 허용
    "resolveJsonModule": true,
    // CJS/ESM 호환성 옵션
    "esModuleInterop": true,
    // default import 허용
    "allowSyntheticDefaultImports": true,
    // 파일명 대소문자 일관성 강제(크로스 OS 안전)
    "forceConsistentCasingInFileNames": true
  }
}
